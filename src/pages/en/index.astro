---
import MainGridLayout from '../../layouts/MainGridLayout.astro'
import { getCollection } from 'astro:content'
import { isPostPublishable } from '@utils/content-utils'
import { img, isCdnRef } from '../../lib/images'
import { getCategory } from '../../lib/categories'

const allEn = await getCollection('posts-en', ({ data }) => isPostPublishable(data))
const posts = allEn.sort((a, b) =>
  new Date(b.data.published).getTime() - new Date(a.data.published).getTime(),
)
---

<MainGridLayout
  title="Mundo Ingeniería - Heavy Machinery & Engineering"
  description="Technical articles on heavy machinery, diesel engines, hydraulic systems, and engineering calculators. Content from official manufacturer manuals (Caterpillar, Cummins, Volvo)."
  canonical="https://www.mundoingenieria.org/en/"
  showSidebar={false}
>
  <article class="max-w-5xl mx-auto">
    <header class="mb-10">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-[-0.02em] leading-[1.05] text-[var(--deep-text)] dark:text-white/95 mb-5">
        Heavy Machinery Engineering
      </h1>
      <p class="text-lg md:text-xl text-black/60 dark:text-white/65 leading-[1.55] max-w-3xl">
        Technical articles based on official manuals from Caterpillar, Cummins, Volvo, and other manufacturers. Deep dives into diesel engines, hydraulic systems, and engineering fundamentals.
      </p>
    </header>

    <section class="mb-12 p-5 md:p-6 rounded-2xl bg-[var(--primary)]/[0.05] dark:bg-[var(--primary)]/[0.08] border border-[var(--primary)]/20 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <h2 class="text-lg md:text-xl font-bold tracking-tight mb-1 text-[var(--deep-text)] dark:text-white/95">
          English version is growing
        </h2>
        <p class="text-sm md:text-base text-black/70 dark:text-white/70 leading-relaxed">
          Currently {posts.length} articles translated. For the full catalog with 600+ articles and 14 calculators, visit the Spanish site.
        </p>
      </div>
      <a
        href="/"
        class="shrink-0 inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-[var(--primary)] text-white font-semibold hover:opacity-90 transition text-sm"
      >
        Spanish site
        <span>→</span>
      </a>
    </section>

    {posts.length > 0 && (
      <section class="mb-16">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-6 text-[var(--deep-text)] dark:text-white/95">
          All English articles
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {posts.map(entry => {
            const cat = getCategory(entry.data.category)
            const hasCover = !!entry.data.image
            const coverUsesCdn = hasCover && isCdnRef(entry.data.image as string)
            const coverUrl = coverUsesCdn
              ? img(entry.data.image as string, { width: 800, height: 450, crop: 'fill' })
              : ''
            return (
              <a
                href={`/en/posts/${entry.id}/`}
                class="group flex flex-col rounded-2xl overflow-hidden border border-black/[0.08] dark:border-white/[0.1] bg-white dark:bg-[var(--card-bg)] hover:shadow-lg hover:-translate-y-0.5 transition"
              >
                {coverUsesCdn ? (
                  <img
                    src={coverUrl}
                    alt={entry.data.title}
                    loading="lazy"
                    decoding="async"
                    class="w-full aspect-[16/9] object-cover"
                  />
                ) : cat ? (
                  <div class={`w-full aspect-[16/9] ${cat.bg} flex items-center justify-center`}>
                    <span class={`text-xs uppercase tracking-widest font-semibold ${cat.text}`}>
                      {cat.label}
                    </span>
                  </div>
                ) : null}
                <div class="p-5 flex flex-col flex-1">
                  {cat && (
                    <span class={`inline-block self-start text-[0.65rem] font-semibold uppercase tracking-[0.12em] px-2 py-0.5 rounded ${cat.chip} mb-3`}>
                      {cat.label}
                    </span>
                  )}
                  <h3 class="text-base md:text-lg font-bold leading-snug text-[var(--deep-text)] dark:text-white/95 group-hover:text-[var(--primary)] transition mb-2 line-clamp-2">
                    {entry.data.title}
                  </h3>
                  {entry.data.description && (
                    <p class="text-sm text-black/60 dark:text-white/60 leading-relaxed line-clamp-3">
                      {entry.data.description}
                    </p>
                  )}
                </div>
              </a>
            )
          })}
        </div>
      </section>
    )}

    <section class="mb-12">
      <h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-6 text-[var(--deep-text)] dark:text-white/95">
        Topics covered
      </h2>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 text-black/75 dark:text-white/75">
        <li class="p-4 rounded-lg border border-black/[0.08] dark:border-white/[0.08]">
          <strong class="text-[var(--deep-text)] dark:text-white/95">Diesel Engines</strong>
          <p class="text-sm text-black/60 dark:text-white/60 mt-1">Caterpillar ACERT, Cummins ISX/Signature, Volvo D7E — architecture, diagnostics, service</p>
        </li>
        <li class="p-4 rounded-lg border border-black/[0.08] dark:border-white/[0.08]">
          <strong class="text-[var(--deep-text)] dark:text-white/95">Hydraulic Systems</strong>
          <p class="text-sm text-black/60 dark:text-white/60 mt-1">Pumps, valves, cylinders, motors, oils and maintenance</p>
        </li>
        <li class="p-4 rounded-lg border border-black/[0.08] dark:border-white/[0.08]">
          <strong class="text-[var(--deep-text)] dark:text-white/95">Oil Analysis</strong>
          <p class="text-sm text-black/60 dark:text-white/60 mt-1">API/SAE/ISO classifications, SOS testing, additives, contamination</p>
        </li>
        <li class="p-4 rounded-lg border border-black/[0.08] dark:border-white/[0.08]">
          <strong class="text-[var(--deep-text)] dark:text-white/95">Emissions Standards</strong>
          <p class="text-sm text-black/60 dark:text-white/60 mt-1">EPA Tier 4, Euro Stage V, ACERT vs SCR, DPF and DEF systems</p>
        </li>
      </ul>
    </section>
  </article>
</MainGridLayout>
