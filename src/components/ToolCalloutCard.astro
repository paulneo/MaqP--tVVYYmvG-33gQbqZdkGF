---
/**
 * Callout visual con CTA hacia una calculadora relacionada.
 *
 * Se usa en los posts para hacer cross-linking hacia /herramientas/.
 * Recibe el objeto Tool completo y lo renderiza como una card destacada.
 */
import { Icon } from 'astro-icon/components'
import type { Tool } from '../lib/tools'

interface Props {
  tool: Tool
}

const { tool } = Astro.props
---

<aside
  class="tool-callout my-10 relative overflow-hidden rounded-2xl border border-[var(--primary)]/25 bg-gradient-to-br from-[var(--primary)]/[0.06] via-[var(--primary)]/[0.02] to-transparent dark:from-[var(--primary)]/[0.10] dark:via-[var(--primary)]/[0.04] dark:to-white/[0.02] p-6 md:p-7"
>
  <div class="flex flex-col md:flex-row md:items-center gap-4 md:gap-6">
    <!-- Icono -->
    <div class="shrink-0">
      <div
        class="w-14 h-14 md:w-16 md:h-16 rounded-xl bg-[var(--primary)]/15 dark:bg-[var(--primary)]/25 flex items-center justify-center"
      >
        <Icon name={tool.icon} class="w-7 h-7 md:w-8 md:h-8 text-[var(--primary)]" />
      </div>
    </div>

    <!-- Contenido -->
    <div class="flex-1 min-w-0">
      <p
        class="text-[0.7rem] uppercase tracking-[0.18em] font-semibold text-[var(--primary)] mb-1.5"
      >
        Calculadora relacionada
      </p>
      <h3
        class="text-lg md:text-xl font-bold text-[var(--deep-text)] dark:text-white/95 mb-1.5 leading-tight"
      >
        {tool.title}
      </h3>
      <p class="text-sm md:text-[0.95rem] text-black/65 dark:text-white/70 leading-relaxed">
        {tool.description}
      </p>
    </div>

    <!-- CTA -->
    <div class="shrink-0">
      <a
        href={`/herramientas/${tool.slug}/`}
        class="inline-flex items-center gap-2 px-4 py-2.5 md:px-5 md:py-3 rounded-lg bg-[var(--primary)] text-white font-semibold hover:opacity-90 transition text-sm md:text-base whitespace-nowrap"
      >
        Abrir calculadora
        <Icon name="material-symbols:arrow-forward" class="w-4 h-4" />
      </a>
    </div>
  </div>
</aside>
