---
/**
 * Selector de idioma para el header.
 * Muestra la bandera del OTRO idioma (el destino del click).
 *
 * El Navbar vive fuera del container swup (<main id="swup">), por lo que
 * este componente no re-renderiza al navegar. Un script client-side
 * reevalúa el idioma actual desde window.location.pathname en cada visita.
 */
import { getLocaleFromUrl, getAlternateLangUrl, languages } from '../i18n'

const currentLang = getLocaleFromUrl(Astro.url)
const pathname = Astro.url.pathname

const otherLang = currentLang === 'es' ? 'en' : 'es'
const otherUrl = getAlternateLangUrl(pathname, currentLang, otherLang)
const otherLabel = languages[otherLang]
const otherFlag = otherLang === 'es' ? '🇪🇸' : '🇺🇸'
---

<a
  href={otherUrl}
  data-lang-selector
  class="lang-selector inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-md text-sm text-black/65 dark:text-white/65 hover:bg-black/[0.05] dark:hover:bg-white/[0.06] hover:text-[var(--primary)] transition"
  aria-label={`Switch to ${otherLabel}`}
  title={otherLabel}
>
  <span class="text-base leading-none" data-lang-flag>{otherFlag}</span>
  <span class="hidden md:inline uppercase text-xs font-semibold tracking-wider" data-lang-code>
    {otherLang}
  </span>
</a>

<script is:inline>
  (function () {
    function refreshLangSelector() {
      const el = document.querySelector('[data-lang-selector]')
      if (!el) return
      const path = window.location.pathname
      const first = path.split('/')[1]
      const currentLang = first === 'en' ? 'en' : 'es'
      const otherLang = currentLang === 'es' ? 'en' : 'es'
      const otherFlag = otherLang === 'es' ? '🇪🇸' : '🇺🇸'
      const otherLabel = otherLang === 'es' ? 'Español' : 'English'
      let otherUrl
      if (otherLang === 'en') {
        otherUrl = '/en' + path
      } else {
        otherUrl = path.startsWith('/en/') ? path.replace(/^\/en/, '') || '/' : path
      }
      el.setAttribute('href', otherUrl)
      el.setAttribute('aria-label', 'Switch to ' + otherLabel)
      el.setAttribute('title', otherLabel)
      const flag = el.querySelector('[data-lang-flag]')
      const code = el.querySelector('[data-lang-code]')
      if (flag) flag.textContent = otherFlag
      if (code) code.textContent = otherLang
    }

    refreshLangSelector()

    // swup no re-renderiza el Navbar (está fuera de <main>). Escuchamos
    // el hook page:view (dispara después de cada navigate) para
    // reevaluar el idioma actual desde window.location.
    document.addEventListener('swup:page:view', refreshLangSelector)
    document.addEventListener('swup:contentReplaced', refreshLangSelector)
  })()
</script>
